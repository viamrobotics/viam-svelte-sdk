{
  "$schema": "./node_modules/@viamrobotics/claude-config/schema/manifest.schema.json",
  "repo": {
    "name": "viam-svelte-sdk",
    "monorepo": false,
    "packageManager": "pnpm",
    "nodeVersion": "24",
    "packageScope": "@viamrobotics",
    "workspaceRootPackage": "@viamrobotics/svelte-sdk",
    "wireit": true
  },
  "rules": {
    "modules": {
      "svelte": true,
      "typescript": true,
      "testingFrontend": true,
      "changesets": true,
      "prDescription": true
    }
  },
  "mcp": {
    "svelteTransport": "stdio",
    "vscode": false
  },
  "outputStyle": {
    "terse": "default"
  },
  "hooks": {
    "sessionStart": true
  },
  "ci": {
    "setupAction": true,
    "weeklyDependencyUpdate": true
  },
  "verify": {
    "lint": "pnpm lint",
    "check": "pnpm check",
    "test": "pnpm test",
    "build": "pnpm build"
  },
  "workflows": {
    "secrets": {
      "slackAlertWebhook": true,
      "gitAccessToken": true,
      "githubApp": false,
      "jira": false
    }
  }
}
